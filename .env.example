# Self-hosted SLM (production — no API keys required)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
USE_OLLAMA=1
OLLAMA_PULL_ON_START=1

# Optional cloud fallback (leave blank for unlimited Ollama-only)
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Production HTTPS (docker-compose.prod.yml)
DOMAIN=leonardo.yourmuseum.org

# App
PORT=8080
APP_PORT=8080
